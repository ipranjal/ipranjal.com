---
import Layout from '../layouts/Layout.astro';
import Illustration from '../components/Illustration.astro';
import { site } from '../data/site';
---
<Layout title="Your free Practical AI guides | Pranjal Pandey" description="Download the AI Strategy Starter for your business, the Personal AI Starter Kit for yourself, or both." minimal noindex>
  <div class="wrap">
    <header class="page-heading"><p class="eyebrow">Welcome to Practical AI</p><h1>You're in.<br />Pick your free guides.</h1><p class="lead">Take one, or take both. No second email needed.</p></header>
    <div class="download-picker">
      <section class="download-card"><Illustration name="guide-business" /><p class="eyebrow">For your business</p><h2>AI Strategy Starter for Founders & Leaders</h2><p>Where AI actually fits in your company: the five questions, your first three workflows, and why pilots stall.</p><a class="button" href="/files/ai-strategy-starter.pdf" download="ai-strategy-starter.pdf" data-guide="business">Download the business guide (PDF)</a><p class="fine-print">Start with the five questions before choosing your first AI workflow.</p></section>
      <section class="download-card"><Illustration name="guide-personal" /><p class="eyebrow">For you</p><h2>The Personal AI Starter Kit</h2><p>Ten copy-paste AI workflows for your week. Works with Claude, ChatGPT or Gemini.</p><a class="button" href="/files/personal-ai-starter-kit.pdf" download="personal-ai-starter-kit.pdf" data-guide="personal">Download the personal kit (PDF)</a><p class="fine-print">Try workflow #1 this Sunday. Set aside 20 minutes to plan your week.</p></section>
    </div>
    <div class="download-both"><a class="button button-secondary" href="/files/practical-ai-free-guides.zip" download="practical-ai-free-guides.zip" data-guide="both">Download both (ZIP)</a></div>
    <section class="section" aria-labelledby="welcome-next-title">
      <h2 id="welcome-next-title">Want to go further?</h2>
      <div class="card-grid">
        <a class="card" href="/writing/"><h3>Keep reading.</h3><p>Explore the latest practical AI essays.</p><span class="text-link">Explore the writing <span aria-hidden="true">&#8594;</span></span></a>
        <div class="card"><h3>Plan your business's next move.</h3><p>Start with a free call, or book a dedicated strategy session.</p><div class="actions"><a class="button" href="/call/">Book a free call</a><a class="text-link" href="/strategy/">Explore the strategy session <span aria-hidden="true">&#8594;</span></a></div></div>
        <div class="card"><h3>Build a career in AI.</h3><p>Find a direction and portfolio projects that show your skills.</p><div class="actions"><a class="button" href="/career/">Book a career session</a></div></div>
      </div>
    </section>
    <div class="reading reading-start">
      <p>You'll also get <em>Practical AI</em>, my monthly letter with a business section and a section for you. Move my emails to your primary inbox so the letter doesn't land in promotions. You can unsubscribe anytime.</p>
      <p>More guides are coming: AI for Startups, the AI Portfolio Playbook and more. Subscribers get them first.</p>
      <p>Having trouble with a download? <a href={`mailto:${site.email}?subject=Help%20with%20the%20free%20guides`}>Email {site.email}</a>.</p>
    </div>
  </div>
</Layout>
