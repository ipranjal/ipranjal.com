---
import Layout from '../layouts/Layout.astro';
import Portrait from '../components/Portrait.astro';
import Method from '../components/Method.astro';
import Signup from '../components/Signup.astro';
import WritingCard from '../components/WritingCard.astro';
import Illustration from '../components/Illustration.astro';
import TaskScorer from '../components/TaskScorer.astro';
import TaskfloShowcase from '../components/TaskfloShowcase.astro';
import { site } from '../data/site';
import { publishedWriting } from '../lib/writing';
const latestWriting = (await publishedWriting()).slice(0, 3);
---
<Layout title="Pranjal Pandey | Practical AI Strategy for Founders & Leaders"
  description="Practical AI for your business and your life. AI strategy for companies, workflows and career help for individuals. Builder, advisor and PhD researcher." home hasSignup>
  <div class="wrap section-frame">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Practical AI strategy for founders & leaders</p>
        <h1 id="hero-title">AI strategy that survives <span>Monday morning.</span></h1>
        <p class="lead">I help founders and leadership teams work out where AI actually fits, and turn pilots into workflows people use every day.</p>
        <div class="actions">
          <a class="button" href="#guide">Get the free guide <span aria-hidden="true">&#8595;</span></a>
          <a class="button button-secondary" href="/call/">Book a call <span aria-hidden="true">&#8599;</span></a>
        </div>
      </div>
      <Portrait hero />
    </section>
    <section class="audience-chooser" aria-labelledby="chooser-title">
      <p class="eyebrow">What brings you here?</p><h2 id="chooser-title">Two doors. Same practical approach.</h2>
      <div class="audience-doors"><a href="/business/"><Illustration name="choose-business" /><div><p class="eyebrow">For my company</p><h3>Choose the AI work that matters.</h3><p>Strategy, audits and AI workflows for founders and leadership teams.</p><span class="text-link">Explore business <span aria-hidden="true">&#8594;</span></span></div></a><a href="/individuals/"><Illustration name="choose-individual" /><div><p class="eyebrow">For myself</p><h3>Make AI work for your week.</h3><p>Workflows, guides and career help, for people who'd rather use AI well than read another hype thread.</p><span class="text-link">Explore for individuals <span aria-hidden="true">&#8594;</span></span></div></a></div>
    </section>
    <section class="section blockers band" data-reveal-group>
      <div data-reveal><p class="eyebrow">Why pilots stall</p><h2>Everyone has an AI strategy deck. Few have AI that works.</h2></div>
      <div class="card-grid">
        <div class="card" data-reveal><Illustration name="problem-ideas" /><h3>Too many ideas, no priority.</h3><p>Twenty use cases, and no shared answer to which one comes first.</p></div>
        <div class="card" data-reveal><Illustration name="problem-permissions" /><h3>Permissions are an afterthought.</h3><p>Nobody can say where the data goes or what the AI is allowed to touch.</p></div>
        <div class="card" data-reveal><Illustration name="problem-habit" /><h3>The pilot never becomes a habit.</h3><p>The demo worked, but it didn't fit the people doing the work.</p></div>
      </div>
      <TaskfloShowcase compact />
    </section>
    <section class="section method-section" id="method">
      <div class="section-intro"><div><p class="eyebrow">How I work</p><h2>Diagnose. Decide. Build.</h2></div><p>The output is a useful next move, not a giant report.</p></div>
      <Method />
      <div class="actions"><a class="text-link" href="/business/">See how we can work together <span aria-hidden="true">&#8594;</span></a></div>
    </section>
    <section class="section band" aria-labelledby="scorer-title">
      <div class="section-intro"><div><p class="eyebrow">Try it</p><h2 id="scorer-title">Should AI do this task?</h2></div><p>Pick one task from your week and move the sliders.</p></div>
      <TaskScorer id="scorer" />
      <a class="text-link" href="/writing/which-tasks-to-automate-with-ai/">Read the full framework <span aria-hidden="true">&#8594;</span></a>
    </section>
    <section class="section proof-grid">
      <div class="proof-intro"><p class="eyebrow">One question, different scales</p><h2>What keeps a system useful?</h2><p>From my first software at 15 to enterprise workflows and <a href="/research/">multi-agent research</a>, I've followed the same question.</p><a class="text-link" href="/about/">The longer story <span aria-hidden="true">&#8594;</span></a></div>
      <div class="card-grid">
        <a class="card ledger-entry" href="/business/"><Illustration name="choose-business" /><span class="eyebrow">Advising</span><h3>AI strategy for founders & leaders</h3><p>Strategy, audits and AI workflows, scoped with your team and built to stick.</p><span class="text-link">How I work with teams <span aria-hidden="true">&#8594;</span></span></a>
        <a class="card ledger-entry" href="/business/"><Illustration name="method-build" /><span class="eyebrow">Applied work</span><h3>From architecture to workflow.</h3><p>Enterprise platforms, AI integrations, and the decisions about permissions and ownership.</p><span class="text-link">How I work with teams <span aria-hidden="true">&#8594;</span></span></a>
        <a class="card ledger-entry" href="/research/"><Illustration name="research" /><span class="eyebrow">Research</span><h3>How should agents divide the work?</h3><p>PhD research at IIT Jodhpur in multi-agent systems and fair division.</p><span class="text-link">Explore the research <span aria-hidden="true">&#8594;</span></span></a>
      </div>
    </section>
    <section class="section guide-section band" id="guide" aria-labelledby="home-guide-title">
      <div class="guide-covers"><Illustration name="guide-business" /><Illustration name="guide-personal" /></div>
      <div class="guide-copy"><p class="eyebrow">Free PDF + monthly letter</p><h2 id="home-guide-title">Before you build another pilot.</h2>
        <ul class="guide-contents"><li>Five questions to ask before an AI project.</li><li>How to choose your first three workflows.</li><li>The mistakes that stop a pilot becoming useful.</li></ul>
      <div class="guide-signup-panel" aria-labelledby="home-signup-title">
        <Signup id="home-email" audience="business" titleId="home-signup-title" kitLink />
      </div>
      </div>
    </section>
    <section class="section writing-preview">
      <div class="section-intro"><div><p class="eyebrow">From the monthly letter</p><h2>Practical AI, written down.</h2></div><a class="text-link" href="/writing/">All writing <span aria-hidden="true">&#8594;</span></a></div>
      {latestWriting.length ? <div class="article-list writing-grid home-writing-grid">{latestWriting.map(entry => <WritingCard entry={entry} showDate={false} />)}</div> : <div class="empty-note"><p>No essays published here yet. <a href={site.linkedin}>Follow my updates on LinkedIn</a>.</p></div>}
    </section>
    <section class="section close band"><Illustration name="choose-business" /><h2>Got an AI idea that's stuck?</h2><p>If you're working out where AI fits in your team or company, I'm happy to talk. No pitch deck needed.</p><div class="actions"><a class="button" href="/call/">Book a call <span aria-hidden="true">&#8599;</span></a><a class="button button-secondary" href={`mailto:${site.email}`}>Email me</a></div></section>
  </div>
  <script>
    import '../scripts/home';
  </script>
</Layout>
