---
import Layout from '../layouts/Layout.astro';
import Portrait from '../components/Portrait.astro';
import WritingCard from '../components/WritingCard.astro';
import Illustration from '../components/Illustration.astro';
import { individualGuides } from '../data/guides';
import { publishedWriting } from '../lib/writing';
const essays = (await publishedWriting()).filter(entry => entry.data.audience === 'individuals').slice(0, 3);
const workflows = [
  { time: 'Sunday · 20 min', title: 'Plan your week', description: 'Turn a messy brain-dump into a plan that respects your energy, not just your calendar.', illustration: 'choose-individual' },
  { time: 'Before meetings · 10 min', title: 'Prep any meeting', description: "Three points to make, three questions to ask, and the two hardest questions they'll ask you.", illustration: 'guide-personal' },
  { time: 'Friday · 15 min', title: 'The weekly review', description: 'Spot one pattern, then pick one thing to keep, one to stop and one to try.', illustration: 'problem-habit' },
] as const;
---
<Layout title="Practical AI for Individuals: Workflows, Guides & Career Help | Pranjal Pandey" description="Practical AI workflows for your week, step-by-step guides, and 1:1 help building a career in AI and workflow automation. Start with the free Personal AI Starter Kit." audience="individuals" social="individuals">
  <div class="wrap section-frame">
    <header class="individual-opening">
      <div class="page-heading"><p class="eyebrow">Practical AI for individuals</p><h1>AI that works for you, at work and in life.</h1><p class="lead">Workflows, guides and 1:1 help for people who'd rather use AI well than read another hype thread.</p><div class="actions"><a class="button" href="/kit/">Get the free kit</a><a class="button button-secondary" href="/career/">Book a career session</a></div></div>
      <Illustration name="choose-individual" />
    </header>
    <section class="section kit-preview" aria-labelledby="kit-preview-title">
      <p class="eyebrow">What's in the free kit</p>
      <h2 id="kit-preview-title">A week, with a little less admin.</h2>
      <p class="lead">Ten copy-paste AI workflows. Here are three.</p>
      <div class="card-grid">{workflows.map(workflow => <article class="card kit-card"><Illustration name={workflow.illustration} /><p class="chip-time">{workflow.time}</p><h3>{workflow.title}</h3><p>{workflow.description}</p></article>)}</div>
      <div class="actions"><a class="button" href="/kit/">Get the free kit <span aria-hidden="true">&#8594;</span></a><p class="fine-print">Works with Claude, ChatGPT or Gemini.</p></div>
    </section>
    <section class="section band" data-reveal-group><h2>Three ways I can help.</h2><div class="card-grid">
      <div class="card" data-reveal><Illustration name="guide-personal" /><span class="eyebrow">Start free</span><h3>The Personal AI Starter Kit</h3><p>Ten copy-paste workflows for your week. Works with Claude, ChatGPT or Gemini.</p><a class="button" href="/kit/">Get the free kit <span aria-hidden="true">&#8594;</span></a></div>
      <div class="card" data-reveal><Illustration name="problem-habit" /><span class="eyebrow">Go deeper</span><h3>Put AI into your week.</h3><p>Practical guides that turn AI into a system you use.</p><span class="chip is-quiet">Coming soon</span><a class="text-link" href="/guides/#individual-guides">See the guides <span aria-hidden="true">&#8594;</span></a></div>
      <div class="card" data-reveal><Illustration name="method-build" /><span class="eyebrow">Get 1:1 help</span><h3>Make your next career move.</h3><p>A clear direction and portfolio projects for a career in AI.</p><a class="button" href="/career/">Book a career session <span aria-hidden="true">&#8599;</span></a></div>
    </div></section>
    <section class="section"><div class="section-intro"><h2>Coming soon.<br />For your own next move.</h2><p>Subscribers to Practical AI get new guides first.</p></div><div class="card-grid">{individualGuides.map(guide => <article class="card"><span class="chip is-quiet">Coming soon</span><h3>{guide.title}</h3><p>{guide.description}</p></article>)}</div></section>
    <section class="section" id="career"><div class="section-intro"><div><p class="eyebrow">60 minutes / Paid working session</p><h2>AI Career & Portfolio Kickstart</h2></div><p>For professionals, developers, product and ops people, and serious final-year students moving into AI and workflow automation.</p></div><p class="lead">A clear direction for your background, two or three portfolio project ideas that show real skill, what to learn next and what to skip, and a written summary.</p><div class="actions"><a class="button" href="/career/">Book a career session</a><p class="fine-print">Price and booking on Topmate. Review its booking and refund terms before paying.</p></div></section>
    <section class="section about-intro"><div><h2>Builder. Advisor.<br />Still learning.</h2><p>I started coding at 15, founded my first company at 19, and now design AI workflows for companies while doing a PhD in multi-agent systems at IIT Jodhpur.</p><a class="text-link" href="/about/">The longer story</a></div><Portrait /></section>
    {essays.length > 0 && <section class="section"><div class="archive-heading"><h2>From the writing.</h2><a class="text-link" href="/writing/?audience=individuals">All individual writing</a></div><div class="article-list">{essays.map(entry => <WritingCard entry={entry} />)}</div></section>}
    <section class="section"><h2>A few practical questions.</h2><div class="faq">
      <details><summary>Do I need to know how to code?</summary><p>No. Start with the workflows in a normal AI chat app.</p></details>
      <details><summary>Which AI tool should I use?</summary><p>Whichever you already have. The workflows are designed for Claude, ChatGPT or Gemini. Features and free-tier limits vary by provider.</p></details>
      <details><summary>Are the guides for beginners?</summary><p>Yes. Start with one workflow and adapt it to your own week. Check important outputs and don't paste sensitive information into a public chat.</p></details>
    </div></section>
    <section class="close band"><h2>Start with ten workflows.<br />Keep the ones that stick.</h2><div class="actions"><a class="button" href="/kit/">Get the free kit</a><a class="text-link" href="/business/">Here for your company?</a></div></section>
  </div>
</Layout>
