---
import Layout from '../layouts/Layout.astro';
import Portrait from '../components/Portrait.astro';
import { individualGuides } from '../data/guides';
import { publishedWriting, formatDate } from '../lib/writing';
const essays = (await publishedWriting()).filter(entry => entry.data.audience === 'individuals').slice(0, 3);
---
<Layout title="Practical AI for Individuals: Workflows, Guides & Career Help | Pranjal Pandey" description="Practical AI workflows for your week, step-by-step guides, and 1:1 help building a career in AI and workflow automation. Start with the free Personal AI Starter Kit." audience="individuals" social="individuals">
  <div class="wrap">
    <header class="individual-opening">
      <div class="page-heading"><p class="eyebrow">Practical AI for individuals</p><h1>AI that works for you, at work and in life.</h1><p class="lead">Practical AI workflows, guides and 1:1 help for people who'd rather use AI well than read another hype thread.</p><div class="actions"><a class="button" href="/kit/">Get the free kit</a><a class="text-link" href="/career/">Book a career session</a></div></div>
      <div class="workflow-note"><p class="mono">From the Personal AI Starter Kit</p><h2>A week, with a little less admin.</h2><ol><li><span>Plan</span> Choose the work that matters.</li><li><span>Prepare</span> Walk into the meeting ready.</li><li><span>Review</span> Keep what worked. Change what didn't.</li></ol><a class="text-link" href="/kit/">Start with ten workflows</a></div>
    </header>
    <section class="section"><h2>Three ways I can help.</h2><div class="offer-list">
      <article class="offer-row"><span class="mono">01 / Start free</span><div><h3>The Personal AI Starter Kit</h3><p>Ten copy-paste AI workflows for planning, learning, writing and deciding. Works with Claude, ChatGPT or Gemini.</p></div><a class="text-link" href="/kit/">Get the free kit</a></article>
      <article class="offer-row"><span class="mono">02 / Go deeper</span><div><h3>Put AI into your week.</h3><p>Practical guides that turn AI from a clever chat window into a system you actually use.</p></div><a class="text-link" href="/guides/#individual-guides">See the guides</a></article>
      <article class="offer-row"><span class="mono">03 / Get 1:1 help</span><div><h3>Make your next career move.</h3><p>Moving into AI or workflow automation? Find a clear direction and portfolio projects that show real skill.</p></div><a class="text-link" href="/career/">Book a career session</a></article>
    </div></section>
    <section class="section"><div class="section-intro"><h2>Coming soon.<br />For your own next move.</h2><p>Subscribers to Practical AI get new guides first.</p></div><div class="offer-list">{individualGuides.map(guide => <article class="offer-row"><span class="mono">Coming soon</span><div><h3>{guide.title}</h3><p>{guide.description}</p></div></article>)}</div></section>
    <section class="section" id="career"><div class="section-intro"><div><p class="eyebrow">60 minutes / Paid working session</p><h2>AI Career & Portfolio Kickstart</h2></div><p>For professionals, developers, product and ops people, and serious final-year students moving into AI and workflow automation.</p></div><p class="lead">A clear direction for your background, two or three portfolio project ideas that show real skill, what to learn next and what to skip, and a written summary.</p><div class="actions"><a class="button" href="/career/">Book a career session</a><p class="fine-print">Price and booking on Topmate. Review its booking and refund terms before paying.</p></div></section>
    <section class="section about-intro"><div><h2>Builder. Advisor.<br />Still learning.</h2><p>I started coding at 15, founded my first company at 19, and now design AI workflows for companies while doing a PhD in multi-agent systems at IIT Jodhpur.</p><a class="text-link" href="/about/">The longer story</a></div><Portrait /></section>
    {essays.length > 0 && <section class="section"><div class="archive-heading"><h2>From the writing.</h2><a class="text-link" href="/writing/?audience=individuals">All individual writing</a></div><div class="article-list">{essays.map(entry => <article><p class="mono">Individuals</p><time datetime={entry.data.published.toISOString()}>{formatDate(entry.data.published)}</time><h3><a href={`/writing/${entry.id}/`}>{entry.data.title}</a></h3><p>{entry.data.description}</p></article>)}</div></section>}
    <section class="section"><h2>A few practical questions.</h2><div class="faq">
      <details><summary>Do I need to know how to code?</summary><p>No. Start with the workflows in a normal AI chat app.</p></details>
      <details><summary>Which AI tool should I use?</summary><p>Whichever you already have. The workflows are designed for Claude, ChatGPT or Gemini. Features and free-tier limits vary by provider.</p></details>
      <details><summary>Are the guides for beginners?</summary><p>Yes. Start with one workflow and adapt it to your own week. Check important outputs and don't paste sensitive information into a public chat.</p></details>
    </div></section>
    <section class="close"><h2>Start with ten workflows.<br />Keep the ones that stick.</h2><div class="actions"><a class="button" href="/kit/">Get the free kit</a><a class="text-link" href="/business/">Here for your company?</a></div></section>
  </div>
</Layout>
