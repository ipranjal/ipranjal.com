---
import Layout from '../layouts/Layout.astro';
import Signup from '../components/Signup.astro';
import Illustration from '../components/Illustration.astro';
import { individualGuides } from '../data/guides';
---
<Layout title="Practical AI Guides for Business & Individuals | Pranjal Pandey" description="Free and upcoming practical AI guides: AI strategy for founders and leaders, and AI workflows and career guides for individuals." hasSignup>
  <div class="wrap">
    <header class="page-heading"><h1>Guides</h1><p class="lead">Practical AI, written down. No hype, no 50-tool listicles: just what to do, in what order, and why. Pick your lane.</p></header>
    <nav class="audience-switch tablist" data-link-tabs aria-label="Guide audience"><a class="tab" href="#business-guides" data-guide-choice="business" aria-current="page">For Business</a><a class="tab" href="#individual-guides" data-guide-choice="individuals">For Individuals</a><span class="tab-indicator" aria-hidden="true"></span></nav>
    <div id="business-guides" data-audience-panel="business">
    <section class="guides-opening" aria-labelledby="guides-title">
      <div class="guides-promise">
        <p class="eyebrow">Guides & playbooks / Practical AI</p>
        <h2 id="guides-title">Choose the workflow.<br />Then the tool.</h2>
        <p class="lead">A free guide to choosing your first AI workflows, before building another pilot. For founders & leaders.</p>
        <ul class="guide-contents"><li>Five questions to ask before any AI project.</li><li>How to pick your first three workflows.</li><li>Why most AI pilots stall, and how to make yours stick.</li></ul>
        <p class="fine-print">By Pranjal Pandey. Founder, Taskflo AI. PhD researcher in multi-agent systems at IIT Jodhpur.</p>
        <a class="text-link" href="/guide/">Explore the free business guide</a>
        <Illustration name="guide-business" />
      </div>
      <div class="guide-signup-panel" id="free-guide" aria-labelledby="signup-title">
        <Signup id="guides-email" audience="business" titleId="signup-title" />
      </div>
    </section>
    <section class="section" id="upcoming"><h2>Coming soon.</h2><p class="lead">Subscribers to Practical AI get new guides first.</p><div class="card-grid-2">
      <article class="card"><span class="chip is-quiet">Coming soon</span><h3>AI for Startups</h3><p>A playbook for founders: choose AI workflows, decide what to build or buy, and keep costs under control.</p></article>
      <article class="card"><span class="chip is-quiet">Coming soon</span><h3>AI for Business</h3><p>Choose the right AI projects, get security and teams on board, and turn pilots into everyday workflows.</p></article>
    </div></section>
    <section class="close"><h2>Want to apply it to your business?</h2><p>A paid strategy session gives your question dedicated working time.</p><a class="button" href="/strategy/">Book a strategy session</a></section>
    </div>
    <div id="individual-guides" data-audience-panel="individuals">
      <section class="guides-opening" aria-labelledby="individual-guides-title">
        <div class="guides-promise">
          <p class="eyebrow">Guides & playbooks / Practical AI</p>
          <h2 id="individual-guides-title">Ten workflows.<br />Your own week.</h2>
          <p class="lead">The free Personal AI Starter Kit: copy-paste workflows for planning, learning, writing and deciding. Works with Claude, ChatGPT or Gemini.</p>
          <ul class="guide-contents"><li>Plan your week in 20 minutes.</li><li>Turn an overflowing inbox into a five-item to-do list.</li><li>Learn a topic, prepare for a meeting and make a decision.</li></ul>
          <p class="fine-print">By Pranjal Pandey. Founder, Taskflo AI. PhD researcher in multi-agent systems at IIT Jodhpur.</p>
          <a class="text-link" href="/kit/">Explore the free personal kit</a>
          <Illustration name="guide-personal" />
        </div>
        <div class="guide-signup-panel" aria-labelledby="individual-signup-title">
          <Signup id="individual-guides-email" audience="individuals" titleId="individual-signup-title" />
        </div>
      </section>
      <section class="section"><h2>Coming soon.</h2><p class="lead">Subscribers to Practical AI get new guides first.</p><div class="card-grid">{individualGuides.map(guide => <article class="card"><span class="chip is-quiet">Coming soon</span><h3>{guide.title}</h3><p>{guide.description}</p></article>)}</div></section>
      <section class="close"><h2>Want 1:1 help?</h2><p>Build a direction and portfolio projects around your own background.</p><a class="button" href="/career/">Book a career session</a></section>
    </div>
  </div>
</Layout>
<script>
  const choices = [...document.querySelectorAll<HTMLAnchorElement>('[data-guide-choice]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-audience-panel]')];
  const selectedAudience = () => {
    if (location.hash === '#individual-guides') return 'individuals';
    if (['#business-guides', '#free-guide', '#upcoming'].includes(location.hash)) return 'business';
    try { return localStorage.getItem('guide-audience') === 'individuals' ? 'individuals' : 'business'; }
    catch (error) { console.warn('Could not read guide audience preference.', error); return 'business'; }
  };
  const showAudience = () => {
    const audience = selectedAudience();
    panels.forEach(panel => { panel.hidden = panel.dataset.audiencePanel !== audience; });
    choices.forEach(choice => {
      if (choice.dataset.guideChoice === audience) choice.setAttribute('aria-current', 'page');
      else choice.removeAttribute('aria-current');
    });
  };
  choices.forEach(choice => choice.addEventListener('click', event => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
    event.preventDefault();
    try { localStorage.setItem('guide-audience', choice.dataset.guideChoice ?? 'business'); }
    catch (error) { console.warn('Could not save guide audience preference.', error); }
    history.pushState(null, '', choice.href);
    showAudience();
  }));
  window.addEventListener('hashchange', showAudience);
  window.addEventListener('popstate', showAudience);
  showAudience();
</script>
