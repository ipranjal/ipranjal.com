---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Signup from '../components/Signup.astro';
import Illustration from '../components/Illustration.astro';
import portrait from '../../assets/pranjal-theme.png';
---
<Layout title="Free Personal AI Starter Kit: 10 AI Workflows for Your Week | Pranjal Pandey" description="Ten copy-paste AI workflows for planning your week, clearing your inbox, learning faster and making decisions. Works with Claude, ChatGPT or Gemini. Free." minimal campaign audience="individuals" social="kit">
  <div class="wrap campaign"><section class="guides-opening" aria-labelledby="kit-title">
    <div class="guides-promise"><p class="eyebrow">Free kit / Practical AI</p><h1 id="kit-title">10 AI workflows that give you your week back.</h1><p class="lead">The Personal AI Starter Kit: copy-paste workflows for planning, learning, writing and deciding, which work with Claude, ChatGPT or Gemini.</p>
      <ul class="guide-contents"><li>Plan your week in 20 minutes.</li><li>Turn an overflowing inbox into a five-item to-do list.</li><li>Learn a topic, prepare for a meeting and make a decision.</li><li>A weekly review, four more workflows and a one-page AI cheat sheet.</li></ul>
      <div class="campaign-author"><Image src={portrait} width={96} height={120} format="webp" quality={78} alt="Pranjal Pandey in the website's Midnight Blueprint portrait treatment" /><p>By Pranjal Pandey.<br /><span>Builder since 15. Founder at 19. PhD researcher in multi-agent systems at IIT Jodhpur.</span></p></div>
    </div>
    <div class="guide-signup-panel" aria-labelledby="kit-signup-title"><Illustration name="guide-personal" /><Signup id="kit-email" audience="individuals" titleId="kit-signup-title" /></div>
  </section></div>
</Layout>
