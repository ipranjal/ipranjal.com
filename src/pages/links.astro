---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---
<Layout title="Links | Pranjal Pandey" description="Free Practical AI guides for your business and your life, career help, company sessions and writing." minimal>
  <div class="wrap"><div class="link-index"><p class="mono">Pranjal Pandey</p><h1>Practical AI for your business and your life.</h1><p>Builder, advisor and PhD researcher.</p>
    <section class="link-group"><h2>For you</h2><a class="button" href="/kit/">Get the free Personal AI Starter Kit <span aria-hidden="true">&#8594;</span></a><a class="button button-secondary" href="/career/">Book a career & portfolio session <span aria-hidden="true">&#8599;</span></a></section>
    <section class="link-group"><h2>For your company</h2><a class="button button-secondary" href="/guide/">Get the free AI Strategy Starter <span aria-hidden="true">&#8594;</span></a><a class="button button-secondary" href="/call/">Book a free intro call <span aria-hidden="true">&#8599;</span></a><a class="button button-secondary" href="/strategy/">Book a strategy session <span aria-hidden="true">&#8599;</span></a></section>
    <a class="text-link" href="/writing/">The monthly letter</a><a class="text-link" href={site.taskflo}>Taskflo AI</a><a class="text-link" href="/research/">Research</a><a class="text-link" href={site.linkedin}>LinkedIn</a><a class="text-link" href={site.github}>GitHub</a><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
  </div></div>
</Layout>
