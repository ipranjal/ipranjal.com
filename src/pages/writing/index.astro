---
import Layout from '../../layouts/Layout.astro';
import Signup from '../../components/Signup.astro';
import { publishedWriting, formatDate } from '../../lib/writing';
import { site } from '../../data/site';
const entries = await publishedWriting();
---
<Layout title="Writing & Practical AI | Pranjal Pandey" description="Practical AI, a monthly letter from Pranjal Pandey on AI strategy, useful workflows and lessons from building.">
  <div class="wrap writing-layout">
    <div class="writing-main">
      <header class="writing-heading"><p class="eyebrow">Writing / Practical AI</p><h1>AI, in the work.</h1><p class="lead">Practical AI strategy for founders and leaders: what works, what stalls, and how to make AI stick.</p></header>
      <section aria-labelledby="essays-title"><div class="archive-heading"><h2 id="essays-title">The essays</h2><a class="text-link" href="/rss.xml">RSS feed</a></div>
        {entries.length ? <div class="article-list">{entries.map(entry => <article><time datetime={entry.data.published.toISOString()}>{formatDate(entry.data.published)}</time><h3><a href={`/writing/${entry.id}/`}>{entry.data.title}</a></h3><p>{entry.data.description}</p></article>)}</div> : <div class="empty-note"><p>No essays published here yet. You can <a href="/research/">read my public research</a> or <a href={site.linkedin}>follow my updates on LinkedIn</a> while the archive takes shape.</p></div>}
      </section>
    </div>
    <aside class="guide-signup-panel writing-subscribe" aria-labelledby="writing-signup-title"><p class="eyebrow">Practical AI / Once a month</p><h2 id="writing-signup-title">The monthly letter.</h2><p>Get new writing in your inbox, plus the free AI Strategy Starter. One long letter a month, no fluff.</p><Signup id="writing-email" /></aside>
  </div>
</Layout>
