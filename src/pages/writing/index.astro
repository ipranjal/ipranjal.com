---
import Layout from '../../layouts/Layout.astro';
import Signup from '../../components/Signup.astro';
import WritingCard from '../../components/WritingCard.astro';
import { publishedWriting } from '../../lib/writing';
import { site } from '../../data/site';
const entries = await publishedWriting();
const audiences = [
  { value: 'business', label: 'Business' },
  { value: 'individuals', label: 'Individuals' },
  { value: 'research', label: 'Research' },
].filter(audience => entries.some(entry => entry.data.audience === audience.value));
---
<Layout title="Writing & Practical AI | Pranjal Pandey" description="Practical AI for your business and your life: what works, what stalls, and how to make it stick. One long letter a month." hasSignup>
  <div class="wrap writing-layout">
    <div class="writing-main">
      <header class="writing-heading"><p class="eyebrow">Practical AI</p><h1>Writing</h1><p class="lead">Practical AI for your business and your life: what works, what stalls, and how to make it stick. One long letter a month, no fluff.</p></header>
      <nav class="writing-filter audience-switch tablist" data-link-tabs id="writing-audience" aria-label="Filter writing by audience" hidden><a class="tab" href="/writing/" data-writing-choice="all">All</a>{audiences.map(audience => <a class="tab" href={`/writing/?audience=${audience.value}`} data-writing-choice={audience.value}>{audience.label}</a>)}<span class="tab-indicator" aria-hidden="true"></span></nav>
      <p class="fine-print" id="filter-status" role="status"></p>
      <section aria-labelledby="essays-title"><div class="archive-heading"><h2 id="essays-title">The essays</h2><a class="text-link" href="/rss.xml">RSS feed</a></div>
        {entries.length ? <div class="article-list writing-grid">{entries.map(entry => <WritingCard entry={entry} />)}</div> : <div class="empty-note"><p>No essays published here yet. You can <a href="/research/">read my public research</a> or <a href={site.linkedin}>follow my updates on LinkedIn</a> while the archive takes shape.</p></div>}
        <div class="empty-note" id="filter-empty" hidden><p>No essays in this lane yet. <a href="/kit/">Start with the personal kit</a>, <a href="/research/">explore the research</a>, or switch to All.</p></div>
      </section>
    </div>
    <aside class="guide-signup-panel writing-subscribe" aria-labelledby="writing-signup-title"><h2 id="writing-signup-title">The monthly letter.</h2><p>Get new writing in your inbox, plus both free guides. Something for your business and something for you.</p><Signup id="writing-email" audience="all" button="Subscribe" /></aside>
  </div>
</Layout>
<script>
  const filter = document.querySelector<HTMLElement>('.writing-filter');
  const choices = [...document.querySelectorAll<HTMLAnchorElement>('[data-writing-choice]')];
  const status = document.querySelector<HTMLElement>('#filter-status');
  const empty = document.querySelector<HTMLElement>('#filter-empty');
  const articles = [...document.querySelectorAll<HTMLElement>('[data-writing-audience]')];
  if (filter && choices.length && status && empty) {
    filter.hidden = false;
    const apply = () => {
      const audience = new URL(location.href).searchParams.get('audience') ?? 'all';
      const selected = choices.some(choice => choice.dataset.writingChoice === audience) ? audience : 'all';
      choices.forEach(choice => {
        if (choice.dataset.writingChoice === selected) choice.setAttribute('aria-current', 'page');
        else choice.removeAttribute('aria-current');
      });
      let count = 0;
      articles.forEach(article => {
        article.hidden = selected !== 'all' && article.dataset.writingAudience !== selected;
        if (!article.hidden) count++;
      });
      empty.hidden = count !== 0;
      status.textContent = `${count} ${count === 1 ? 'essay' : 'essays'} shown.`;
    };
    choices.forEach(choice => choice.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
      event.preventDefault();
      const url = new URL(location.href);
      if (choice.dataset.writingChoice === 'all') url.searchParams.delete('audience');
      else url.searchParams.set('audience', choice.dataset.writingChoice!);
      history.pushState(null, '', url);
      apply();
    }));
    window.addEventListener('popstate', apply);
    apply();
  }
</script>
