---
import { method } from '../data/site';
import Illustration from './Illustration.astro';
const illustrations = ['method-diagnose', 'method-decide', 'method-build'] as const;
---
<div class="method-tabs">
  <div class="tablist" role="tablist" aria-label="The method">
    {method.map((step, index) => (
      <button class="tab" type="button" role="tab" id={`method-tab-${index}`} aria-controls={`method-panel-${index}`} aria-selected={index === 0}>{step.name}</button>
    ))}
    <span class="tab-indicator" aria-hidden="true"></span>
  </div>
  {method.map((step, index) => (
    <div class="tabpanel method-panel-grid" id={`method-panel-${index}`} role="tabpanel" aria-labelledby={`method-tab-${index}`} hidden={index !== 0}>
      <div class="illus-host"><Illustration name={illustrations[index]} /></div>
      <div>
        <span class="step-number" aria-hidden="true">0{index + 1}</span>
        <h3>{step.title}</h3>
        <p>{step.detail}</p>
        <div class="method-artifact">
          <span class="mono">{step.output}</span>
          <ul>{step.checks.map(check => <li>{check}</li>)}</ul>
        </div>
      </div>
    </div>
  ))}
</div>
